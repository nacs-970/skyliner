# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Node (only if a build tool is adopted)
node_modules/

# Downloaded SPHEREx products and caches: never commit, except the small display set below
implementation/data/cache/*
!implementation/data/cache/cell_demo/
implementation/data/cache/cell_demo/*
# The display files (not the raw cutouts) of the five NASA test targets, detector D6 only: see implementation/data/README.md
!implementation/data/cache/cell_demo/targets.js
!implementation/data/cache/cell_demo/ra133.7951_dec-7.2451_s0.2_spherex_dr1/
!implementation/data/cache/cell_demo/ra76.9566_dec30.4013_s0.2_spherex_dr1/
!implementation/data/cache/cell_demo/ra248.1672_dec66.7550_s0.2_spherex_dr1/
!implementation/data/cache/cell_demo/ra269.4463_dec4.7675_s0.2_spherex_dr1/
!implementation/data/cache/cell_demo/ra331.0961_dec-56.8005_s0.2_spherex_dr1/
# inside a committed patch: only target.json and D6_full/sky.*.js (never raw cutouts, stores of other detectors, progress files)
implementation/data/cache/cell_demo/*/raw/
implementation/data/cache/cell_demo/*/progress.json
implementation/data/cache/cell_demo/*/D[1-5]_full/
implementation/data/cache/cell_demo/*/D6_full/raw/
implementation/data/cache/cell_demo/*/D6_full/store.cellcache
implementation/data/cache/cell_demo/*/D6_full/store.params.json
*.fits
*.fits.gz
*.fz
# ...except tiny test fixtures
!implementation/data/fixtures/**

# Copies of third-party pages (see the research/ item in AGENTS.md section 7)
research/raw/

# Environment and OS
.env
.env.*
.DS_Store
